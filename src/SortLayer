
export interface ISortLayerOption<T> {
    value: string;
    title: string;
    sourceData?: T;
}

interface ISortLayerProps<T> {
    /** 选项列表 */
    options?: ISortLayerOption<T>[];
    /** 默认选中的值 */
    activeValue?: string;
    /** 选择回调 */
    onChange?: (option: ISortLayerOption<T>) => void;
    /** 点击空白关闭回调，由业务主动关闭 */
    onClose?: () => void;
    /** 自定义样式类名 */
    className?: string;
    /** 测试ID前缀 */
    testIDPrefix?: string;
    /** 最大高度 */
    maxHeight?: string;
    /** 是否显示滚动条 */
    showScrollbar?: boolean;
    /** 距离顶部的距离 */
    top?: string | number;
}

const SortLayer = forwardRef(
    <T,>(
        {
            options = [],
            activeValue,
            onChange,
            className,
            testIDPrefix = 'sort_layer',
            maxHeight = '100%',
            showScrollbar = false,
            onClose,
            top,
        }: ISortLayerProps<T>,
        ref: React.Ref<XViewProps>
    ) => {
        const [selectedValue, setSelectedValue] = useState<string>(activeValue || options[0]?.value || '');

        const handleOptionClick = (option: ISortLayerOption<T>) => {
            if (option.value !== selectedValue) {
                setSelectedValue(option.value);
                onChange?.(option);
            }
        };

        if (options?.length === 0) {
            return null;
        }

        return (
            <XView
                ref={ref}
                className={xClassNames(Styles.container, className)}
                style={{
                    maxHeight,
                    ...(top !== undefined && { top }),
                    ...(xUa.isApp && {
                        width: '100%',
                        backgroundColor: 'rgba(0, 0, 0, 0.7)',
                    }),
                }}
                onClick={() => {
                    onClose?.();
                }}
            >
                <XScrollView
                    style={{
                        width: '100%',
                        height: '100%',
                    }}
                    showScrollbar={showScrollbar}
                    scrollY={false}
                    scrollX={false}
                    bounces={false}
                >
                    {options.map((option, index) => {
                        const isActive = option.value === selectedValue;
                        return (
                            <XView
                                key={`${option.value}_${index}`}
                                className={xClassNames(Styles.optionItem)}
                                onClick={() => handleOptionClick(option)}
                                testID={`${testIDPrefix}_${option.value}`}
                            >
                                <XText className={xClassNames(Styles.optionText, isActive && Styles.optionTextActive)}>
                                    {option.title}
                                </XText>
                                {isActive && (
                                    <XView className={Styles.checkIcon}>
                                        <IconFont className={Styles.checkIconFont}>&#xf1c8;</IconFont>
                                    </XView>
                                )}
                            </XView>
                        );
                    })}
                </XScrollView>
            </XView>
        );
    }
);

SortLayer.displayName = 'SortLayer';

export default React.memo(SortLayer);
